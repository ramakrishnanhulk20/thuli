# Copy this file to .env and fill in the empty values. Never commit .env.

# SERV Reasoning API key, from https://console.openserv.ai under "API keys"
SERV_API_KEY=
# Your Thuli graph id (starts with gr_), from the console's Graphs page after generating the graph from
# packages/rulebook/thuli-rulebook.md
SERV_GRAPH_ID=
# Reppo Evaluation API key, from https://eval.reppo.xyz under "API Key"
REPPO_API_KEY=
# Dolphin API key, from https://v2.dphn.ai under "API Keys"
DOLPHIN_API_KEY=
# Network the paid API charges on: base (real USDC) or base-sepolia (test USDC). No default, so testnet is a choice
X402_NETWORK=
# Base address that receives paid-API income (an address, not a key). Its key must not be on any server or in this file
PAYTO_ADDRESS=
# Base Sepolia address that receives test payments when X402_NETWORK=base-sepolia. Same rule: its key stays off servers
PAYTO_ADDRESS_TESTNET=
# Base Sepolia only: the x402 facilitator. Leave empty for https://x402.org/facilitator. Base mainnet always uses CDP
FACILITATOR_URL=
# Base mainnet only: CDP API key id, from portal.cdp.coinbase.com, API Keys, Secret API Keys, Create API key (Ed25519)
CDP_API_KEY_ID=
# Base mainnet only: the secret shown once when that CDP API key is created
CDP_API_KEY_SECRET=
# Private key of a separate test wallet holding a little USDC. prove:paid pays one screening with it, and prove:vault uses it as the test campaign owner
PAYER_PRIVATE_KEY=
# Port for npm run api:dev. Leave empty for 8787
PORT=
# The https origin the paid API is served at, such as https://api.example.com. Required on base, optional on base-sepolia
PUBLIC_ORIGIN=
# Postgres connection string (postgres://user:password@host:5432/db, TLS unless localhost); the web app and the worker both read it
DATABASE_URL=
# Private key of the worker's small hot wallet on Base (pays Reppo checks and vault gas)
WORKER_PRIVATE_KEY=

SERV_BASE_URL=https://inference-api.openserv.ai/v1
DOLPHIN_BASE_URL=https://lighthouse.dphn.ai/run/text-v/v1
REPPO_BASE_URL=https://eval.reppo.xyz/api/v1
ETH_RPC_URL=https://mainnet.gateway.tenderly.co
# Base mainnet RPC for the paid API on Base and the worker's Base screening. Empty means https://mainnet.base.org; https only
BASE_RPC_URL=https://mainnet.base.org
# Base Sepolia RPC for npm run vault:deploy and npm run prove:vault. The public endpoint works; https only
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BLOCKSCOUT_ETH_API=https://eth.blockscout.com/api/v2
# Blockscout API for Base mainnet history. Leave empty for https://api.blockscout.com/8453/api/v2; https only
BLOCKSCOUT_BASE_API=
# Blockscout API key (starts proapi_), from https://dev.blockscout.com under API keys. Set, asks are screened on Base history too; empty, Ethereum only
BLOCKSCOUT_API_KEY=

# Etherscan API V2 free key: the research replay and contract verification only, never the live product
EXPLORER_API_URL=https://api.etherscan.io/v2/api
EXPLORER_API_KEY=
