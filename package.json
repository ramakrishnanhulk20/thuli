{
  "name": "thuli",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/worker",
    "packages/api",
    "packages/store",
    "packages/web"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p packages/worker/tsconfig.json && tsc -p packages/api/tsconfig.json && tsc -p packages/store/tsconfig.json && npm --prefix packages/web run typecheck",
    "prove:slice": "node --env-file=.env --import tsx packages/worker/scripts/prove-slice.ts",
    "replay:robo": "node --env-file=.env --import tsx packages/worker/scripts/replay-robo.ts",
    "replay:hop": "node --env-file=.env --import tsx packages/worker/scripts/replay-hop.ts",
    "decide:robo": "node --env-file=.env --import tsx packages/worker/scripts/decide-robo.ts",
    "decide:hop": "node --env-file=.env --import tsx packages/worker/scripts/decide-hop.ts",
    "feedback:reppo": "node --env-file=.env --import tsx packages/worker/scripts/feedback-reppo.ts",
    "versions:score": "node --env-file=.env --import tsx packages/worker/scripts/versions-score.ts",
    "export:replay": "node --import tsx packages/worker/scripts/export-replay.ts",
    "appeal:demo": "node --env-file=.env --import tsx packages/worker/scripts/appeal-demo.ts",
    "api:dev": "npm --prefix packages/api run dev",
    "web:dev": "npm --prefix packages/web run dev",
    "web:build": "npm --prefix packages/web run build",
    "prove:paid": "node --env-file=.env.api --env-file=.env.payer --import tsx packages/api/scripts/prove-paid.ts",
    "contracts:test": "forge test --root packages/contracts",
    "contracts:lint": "npm run lint --prefix packages/contracts",
    "vault:deploy": "node --env-file=.env packages/contracts/script/deploy.mjs",
    "prove:vault": "node --env-file-if-exists=.env --import tsx packages/worker/scripts/prove-vault.ts",
    "db:migrate": "node --env-file=.env --import tsx packages/store/scripts/migrate.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
