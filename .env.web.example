# No variable whose name ends in PRIVATE_KEY may ever be set here: the site's paid API refuses to start if one is.
# The website's server settings for the paid and free API under /api/x402 and /api/check. Copy to packages/web/.env.local
# for a local run, or set each one in the host's project settings. Never commit a filled-in copy.

# Network the paid route charges on: base (real USDC) or base-sepolia (test USDC). No default, so testnet is a choice
X402_NETWORK=
# Base Sepolia address that receives test payments when X402_NETWORK=base-sepolia. An address, never a key
PAYTO_ADDRESS_TESTNET=
# Base address that receives the income when X402_NETWORK=base. An address, never a key; its key stays off every server
PAYTO_ADDRESS=
# Base only: CDP API key id, from portal.cdp.coinbase.com, API Keys, Secret API Keys, Create API key (Ed25519)
CDP_API_KEY_ID=
# Base only: the secret shown once when that CDP API key is created
CDP_API_KEY_SECRET=
# The https origin the site is served at, such as https://thuli.example. Required on base, optional on base-sepolia
PUBLIC_ORIGIN=
# Base only: an https Base mainnet RPC, read to check a settlement the facilitator left pending
BASE_RPC_URL=
# Base Sepolia only: the x402 facilitator. Leave empty for https://x402.org/facilitator. Base always uses CDP
FACILITATOR_URL=
# Header the host writes the caller's address into: x-vercel-forwarded-for on Vercel. Required in production
TRUSTED_CLIENT_HEADER=
# postgres:// URL of the database every copy shares. Required in production; empty runs an in-process one locally
DATABASE_URL=
# The same database's direct address, not the pooled one; used instead of DATABASE_URL when set. Vercel's Neon install sets it
DATABASE_URL_UNPOOLED=
# SERV Reasoning API key, from https://console.openserv.ai under "API keys". Every screening calls SERV with it
SERV_API_KEY=
# SERV API base URL, such as https://inference-api.openserv.ai/v1
SERV_BASE_URL=
# Your Thuli graph id (starts with gr_), from the console's Graphs page
SERV_GRAPH_ID=
# Ethereum mainnet https RPC the screening reads wallet facts from
ETH_RPC_URL=
# Blockscout API the screening reads transfers from, such as https://eth.blockscout.com/api/v2
BLOCKSCOUT_ETH_API=
# The id of the live campaign the /campaign page shows. Leave empty and the page says no campaign is open
DEMO_CAMPAIGN_ID=
# WalletConnect project id, from cloud.reown.com. Public by design, and fixed into the site when it is built. Leave empty and only browser wallets are offered
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
