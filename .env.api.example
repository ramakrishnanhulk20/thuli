# The paid API's own settings. Copy to .env.api and fill in. It holds no private key: the API refuses to start if any
# variable ending in PRIVATE_KEY is set. Never commit .env.api.

# Network the API charges on: base (real USDC) or base-sepolia (test USDC). No default, so testnet is a choice
X402_NETWORK=
# Base address that receives the income when X402_NETWORK=base. An address, never a key; its key stays off every server
PAYTO_ADDRESS=
# Base Sepolia address that receives test payments when X402_NETWORK=base-sepolia. Same rule as PAYTO_ADDRESS
PAYTO_ADDRESS_TESTNET=
# Base Sepolia only: the x402 facilitator. Leave empty for https://x402.org/facilitator. Base always uses CDP
FACILITATOR_URL=
# Base only: CDP API key id, from portal.cdp.coinbase.com, API Keys, Secret API Keys, Create API key (Ed25519)
CDP_API_KEY_ID=
# Base only: the secret shown once when that CDP API key is created
CDP_API_KEY_SECRET=
# The https origin the API is served at, such as https://api.example.com. Required on base, optional on base-sepolia
PUBLIC_ORIGIN=
# Port to listen on. Leave empty for 8787
PORT=
# Base only: an https Base mainnet RPC, read to check a settlement the facilitator left pending. Sepolia uses its public RPC
BASE_RPC_URL=https://mainnet.base.org
# Header the host writes the caller's address into, x-vercel-forwarded-for on Vercel. Leave empty with no proxy in front
TRUSTED_CLIENT_HEADER=
# SERV Reasoning API key, from https://console.openserv.ai under "API keys". The screening calls SERV with it
SERV_API_KEY=
# Your Thuli graph id (starts with gr_), from the console's Graphs page
SERV_GRAPH_ID=
# SERV API base URL
SERV_BASE_URL=https://inference-api.openserv.ai/v1
# Ethereum mainnet RPC the screening reads wallet facts from
ETH_RPC_URL=https://mainnet.gateway.tenderly.co
# Blockscout API the screening reads transfers from
BLOCKSCOUT_ETH_API=https://eth.blockscout.com/api/v2
